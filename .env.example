# Supabase (optional for local/demo mode; recommended for persistent deployed data)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email (optional; demo mode always previews, and a missing key also previews)
RESEND_API_KEY=
EMAIL_FROM="LabTrack Demo <onboarding@resend.dev>"

# IANA time zone used to determine the lab's current business date for overdue labels
LAB_TIME_ZONE=Asia/Kolkata
